<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <.live_title default="Air" suffix=" · Phoenix Framework" phx-no-format>{assigns[:page_title]}</.live_title>
    <link phx-track-static rel="stylesheet" href={~p"/assets/css/app.css"} />
    <script defer phx-track-static type="text/javascript" src={~p"/assets/js/app.js"}>
    </script>
    <script>
      (() => {
        const systemTheme = () => matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";

        const setTheme = (theme) => {
          if (theme === "system") {
            localStorage.removeItem("phx:theme");
            document.documentElement.setAttribute("data-theme", systemTheme());
            document.documentElement.setAttribute("data-theme-source", "system");
          } else {
            localStorage.setItem("phx:theme", theme);
            document.documentElement.setAttribute("data-theme", theme);
            document.documentElement.setAttribute("data-theme-source", "user");
          }
        };
        if (!document.documentElement.hasAttribute("data-theme")) {
          setTheme(localStorage.getItem("phx:theme") || "system");
        }
        window.addEventListener("storage", (e) => e.key === "phx:theme" && setTheme(e.newValue || "system"));
        window.addEventListener("phx:set-theme", (e) => setTheme(e.target.dataset.phxTheme));

        matchMedia("(prefers-color-scheme: dark)").addEventListener("change", (e) => {
          if (document.documentElement.getAttribute("data-theme-source") === "system") {
            document.documentElement.setAttribute("data-theme", systemTheme());
          }
        });

        // Theme Editor preset colors (Settings > Theme Editor tab).
        // Overrides daisyUI's own [data-theme=light]/[data-theme=dark]
        // CSS-variable blocks (assets/css/app.css) via a higher-specificity
        // <style> tag injected here, so applying/switching a preset is
        // instant and needs no rebuild/reload. Persisted so the choice
        // survives navigation/reload, same pattern as phx:theme above.
        const PRESET_STORAGE_KEY = "phx:theme-preset-colors";
        let presetStyleEl = null;

        const cssVars = (colors) =>
          Object.entries(colors || {}).map(([k, v]) => `--color-${k}: ${v};`).join(" ");

        const applyPresetColors = (lightColors, darkColors) => {
          if (!presetStyleEl) {
            presetStyleEl = document.createElement("style");
            presetStyleEl.id = "theme-preset-overrides";
            document.head.appendChild(presetStyleEl);
          }
          presetStyleEl.textContent =
            (lightColors ? `[data-theme="light"] { ${cssVars(lightColors)} }\n` : "") +
            (darkColors ? `[data-theme="dark"] { ${cssVars(darkColors)} }` : "");
        };

        const storedPreset = localStorage.getItem(PRESET_STORAGE_KEY);
        if (storedPreset) {
          try {
            const { light, dark } = JSON.parse(storedPreset);
            applyPresetColors(light, dark);
          } catch {}
        }

        window.addEventListener("phx:apply-theme-preset", (e) => {
          const { light, dark } = e.detail || {};
          applyPresetColors(light, dark);
          localStorage.setItem(PRESET_STORAGE_KEY, JSON.stringify({ light, dark }));
        });

        window.addEventListener("phx:clear-theme-preset", () => {
          localStorage.removeItem(PRESET_STORAGE_KEY);
          if (presetStyleEl) presetStyleEl.textContent = "";
        });
      })();
    </script>
  </head>
  <body>
    {@inner_content}
  </body>
</html>
